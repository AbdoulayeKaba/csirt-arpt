# Copier vers .env et ajuster.
# Next.js écoute sur le port 3333 (npm run dev). Pour surcharger : PORT=3333
# Créer la base : CREATE DATABASE cert-arpt CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

# MySQL — base `cert-arpt` (utilisateur / mot de passe / hôte à adapter)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/cert-arpt"

# Migrations Prisma (créer la base vide puis) :
#   npm run db:migrate        # développement : applique + crée de nouvelles migrations
#   npm run db:migrate:deploy # production / CI : applique uniquement les migrations en attente
# Si les tables existaient déjà sans historique Migrate, ne pas recréer la base :
# marquer les migrations déjà appliquées avec `npx prisma migrate resolve --applied <nom>`.

# NextAuth JWT (minimum 32 caractères en production)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32chars"
NEXTAUTH_URL="http://localhost:3333"

# URL publique utilisée dans les liens des e-mails (jamais localhost).
# Exemple production : https://csirt.arpt.gov.gn
# EMAIL_PUBLIC_BASE_URL="https://csirt.arpt.gov.gn"
# NEXT_PUBLIC_APP_URL="https://csirt.arpt.gov.gn"

# Invitations correspondants (organisations partenaires) — durée de validité du lien (heures)
# INVITATION_EXPIRY_HOURS=72

# Signalement public : parcours anonyme conservé mais désactivé par défaut.
# true = autorise le formulaire anonyme (captcha) sans compte CORRESPONDANT.
SIGNALEMENT_ANONYMOUS_ENABLED=false

# Microsoft Entra ID (connexion OAuth managers / SSO)
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# Optionnel : mapping rôles par email (séparés par virgule)
# AZURE_DG_EMAILS=dg@organisation.local
# AZURE_ASSISTANT_EMAILS=assistante@organisation.local
# AZURE_EXTERNAL_DOMAINS=partenaire.com

# Import annuaire Microsoft Entra ID (Graph — permission application User.Read.All)
# Utilise GRAPH_* ou les mêmes variables que AZURE_AD_*
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

# LDAP / Active Directory on-premise (import utilisateurs)
# LDAP_BIND_PASSWORD=secret-liaison-ldap

# SMTP (notifications email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CSIRT-ARPT <noreply@arpt.gov.gn>"

# Cron — collecte automatique des sources (POST /api/cron/news-sync)
# Cron — campagnes newsletter planifiées (POST /api/cron/newsletter-campaigns)
# Header : Authorization: Bearer <secret> ou X-Cron-Secret: <secret>
# Planifier toutes les heures (Windows Task Scheduler, cron Linux, etc.)
# CRON_SECRET=change-me-cron-secret

# Mot de passe seed (optionnel, défaut: password123)
# SEED_PASSWORD=

# Notifications (providers reels)
# Email via Resend (prioritaire si configure)
# RESEND_API_KEY="re_xxx"
# RESEND_FROM_EMAIL="CSIRT-ARPT <no-reply@arpt.gov.gn>"
#
# SMS via Twilio (prioritaire si configure)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM_NUMBER="+221700000000"
#
# Fallback webhook (si vous n'utilisez pas Resend/Twilio)
# NOTIFICATION_EMAIL_WEBHOOK="https://votre-endpoint/email"
# NOTIFICATION_SMS_WEBHOOK="https://votre-endpoint/sms"

# Mode démo sans MySQL (auth + calendrier en mémoire). Avec MySQL : "false"
# Emails de bienvenue réels : USE_MOCK_DATA=false, NEXT_PUBLIC_USE_MOCK_DATA=false, redémarrer,
# puis SMTP (hôte + expéditeur) dans Administration → Paramètres.
USE_MOCK_DATA="false"
# NEXT_PUBLIC_USE_MOCK_DATA="false"

# Après configuration DATABASE_URL :
#   npm run db:migrate
#   npm run db:seed

# Accès direct aux pages / API sans connexion (auto avec USE_MOCK_DATA)
# DISABLE_AUTH="true"
# NEXT_PUBLIC_DISABLE_AUTH="true"

# Assistant IA (optionnel — sans clé, mode assisté basé sur les données réelles)
# OPENAI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"

# reCAPTCHA Google v2 (optionnel) — signalements anonymes
# Sans ces clés, un contrôle « Je ne suis pas un robot » signé côté serveur est utilisé.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# RECAPTCHA_SECRET_KEY="6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Landing — vidéo « Voir le workflow » (MP4 local ou URL YouTube/Vimeo)
# NEXT_PUBLIC_LANDING_WORKFLOW_VIDEO_URL="/videos/workflow.mp4"

# MinIO (S3). Laisser vide en développement local : les fichiers restent sur le disque.
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_BUCKET="csirt-preprod"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION="us-east-1"
# S3_FORCE_PATH_STYLE="true"
# ENABLE_HSTS="true"
